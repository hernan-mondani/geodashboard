    {
      "id": "reliefweb",
      "name": "ReliefWeb situation reports",
      "publisher": "ReliefWeb (UN OCHA)",
      "homepage": "https://reliefweb.int/",
      "type": "humanitarian",
      "feeds": [
        {
          "url": "https://api.reliefweb.int/v2/reports",
          "format": "reliefweb-api",
          "appname": "",
          "limit": 60
        }
      ],
      "note": "English-language situation reports from UN agencies and NGOs, through the ReliefWeb API. Needs an approved appname from ReliefWeb (free); until then this source is skipped.",
      "enabled": true
    }
  ],
